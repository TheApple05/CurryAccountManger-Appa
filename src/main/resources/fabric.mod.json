{
  "schemaVersion": 1,
  "id": "autism",
  "version": "${version}",
  "name": "AUTISM Account Manager",
  "description": "A client-side Minecraft account manager.",
  "authors": [
    "Melonik"
  ],
  "contributors": [
    "Melonik"
  ],
  "contact": {
    "homepage": "https://ko-fi.com/melonik",
    "sources": "https://ko-fi.com/melonik"
  },
  "custom": {
    "modmenu": {
      "links": {
        "Discord": "https://discord.gg/2WQuvztM8m",
        "Donate": "https://ko-fi.com/melonik"
      }
    }
  },
  "icon": "assets/autismclient/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "autismclient.AutismAccountManagerMod"
    ]
  },
  "mixins": [
    "autism.mixins.json"
  ],
  "depends": {
    "java": ">=25",
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=0.20.1",
    "fabric-api": ">=${fabric_api_version}"
  },
  "license": "GPL-3.0-only",
  "jars": [{ "file": "META-INF/jars/waybackauthlib-1.1.0.jar" }]
}
